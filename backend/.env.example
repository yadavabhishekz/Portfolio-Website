GROQ_API_KEY=your-groq-api-key-here
# Optional: more keys, comma-separated. Requests rotate across all keys and
# fall back to the next one when a key is rate-limited.
# GROQ_API_KEYS=key2,key3
# Optional: override the chat model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: model tried after every key is rate-limited on GROQ_MODEL
# (default: openai/gpt-oss-20b; set to empty to disable)
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
